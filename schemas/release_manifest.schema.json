{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waveshed.io/schemas/aether/release_manifest.schema.json",
  "title": "Waveshed release manifest (latest.json)",
  "description": "Update manifest served from waveshed.io and consumed by the Waveshed QGIS plugin. NOTE: this schema is the agreed interface and could NOT be verified against readable source (the consumer is the out-of-scope QGIS plugin). sha256 is fail-closed: a consumer MUST verify the digest and refuse to install on any mismatch/absence.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "version", "released_at", "assets"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1, "description": "Manifest schema version." },
    "version": { "type": "string", "description": "Semantic version of the release." },
    "released_at": { "type": "string", "format": "date-time", "description": "ISO-8601 UTC timestamp." },
    "changelog_url": { "type": "string", "format": "uri" },
    "eula_url": { "type": "string", "format": "uri" },
    "min_plugin_version": { "type": "string", "description": "Minimum plugin version required to use these assets." },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": true,
      "required": ["platform", "arch", "filename", "url", "size_bytes", "sha256"],
      "properties": {
        "platform": { "type": "string", "enum": ["windows", "linux", "macos"] },
        "arch": { "type": "string", "enum": ["x64", "arm64"] },
        "filename": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Lowercase 64-hex SHA-256 digest; verified fail-closed by the consumer." }
      }
    }
  }
}
